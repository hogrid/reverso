# Reverso CMS Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
REVERSO_PORT=3001
REVERSO_HOST=0.0.0.0

# Security (REQUIRED in production)
# Generate with: openssl rand -hex 32
REVERSO_COOKIE_SECRET=your-secure-cookie-secret-here

# API key for programmatic access: `reverso scan --api-key`, CI, MCP.
# Generate with: openssl rand -hex 24
REVERSO_API_KEY=

# Authentication is ON by default. Set to false ONLY for a local experiment
# on a machine nobody else can reach; every request is then treated as admin.
# REVERSO_AUTH_ENABLED=false

# Set to true when running behind a reverse proxy (nginx, Caddy, Coolify,
# Railway...) so client IPs, rate limits and HTTPS detection use X-Forwarded-*.
REVERSO_TRUST_PROXY=false

# Secure flag on the session cookie: auto (Secure only over HTTPS), true, false.
# Keep "auto" until TLS is in place, then set "true".
REVERSO_COOKIE_SECURE=auto

# CORS: origins allowed to call the API from a browser (comma-separated or *).
# Only needed when a frontend fetches the public API client-side (Vite, Astro
# islands). Server-side reads (Next.js RSC) need nothing here.
# REVERSO_CORS_ORIGIN=https://www.example.com,http://localhost:5173

# Extra hosts allowed as redirect targets (relative paths are always allowed)
# REVERSO_ALLOWED_REDIRECT_DOMAINS=example.com,www.example.com

# NODE_ENV=production hides stack traces and requires REVERSO_COOKIE_SECRET.

# Database Configuration
# SQLite (default; the only provider implemented today)
REVERSO_DB_PATH=.reverso/reverso.db

# Where `reverso scan` pushes the schema when not running next to `reverso dev`
# REVERSO_API_URL=https://cms.example.com

# PostgreSQL is not implemented yet; the `--profile postgres` service in
# docker-compose.yml is reserved for it (POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_DB / POSTGRES_PORT apply to that container only).

# MCP server (reverso-mcp): optional key required from AI clients
# REVERSO_MCP_API_KEY=
