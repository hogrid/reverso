# Reverso CMS Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
REVERSO_PORT=3001
REVERSO_HOST=0.0.0.0

# Security (REQUIRED in production)
# Generate with: openssl rand -hex 32
REVERSO_COOKIE_SECRET=your-secure-cookie-secret-here

# API key for programmatic access: `reverso scan --api-key`, CI, MCP.
# Generate with: openssl rand -hex 24
REVERSO_API_KEY=

# Authentication is ON by default. Set to false ONLY for a local experiment
# on a machine nobody else can reach; every request is then treated as admin.
# REVERSO_AUTH_ENABLED=false

# Set to true when running behind a reverse proxy (nginx, Caddy, Coolify,
# Railway...) so client IPs and rate limits use X-Forwarded-For.
REVERSO_TRUST_PROXY=false

# CORS Configuration (origin of the frontend that reads the public API)
REVERSO_CORS_ORIGIN=http://localhost:3000

# Optional token-based CSRF layer on top of the SameSite cookie + Origin check
REVERSO_CSRF_ENABLED=false

# Database Configuration
# SQLite (default; the only provider implemented today)
REVERSO_DB_PATH=.reverso/reverso.db

# Where `reverso scan` pushes the schema when not running next to `reverso dev`
# REVERSO_API_URL=https://cms.example.com

# PostgreSQL (docker-compose --profile postgres; provider support is planned)
POSTGRES_USER=reverso
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=reverso
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reverso:your-secure-password-here@postgres:5432/reverso
