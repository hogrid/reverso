# Keep the build context small and never let host build artefacts (macOS
# native binaries, stale dist, turbo cache) leak into the image. Patterns are
# anchored with `**/` so they apply inside every workspace package.

**/node_modules
**/.pnpm-store
**/dist
**/.next
**/.astro
**/.turbo
**/.cache
**/*.tsbuildinfo
**/coverage
**/playwright-report
**/test-results
**/.test
**/__tests__
**/*.test.ts
**/*.spec.ts
**/e2e

# Local data
**/.reverso
**/*.db
**/*.db-shm
**/*.db-wal

# Environment and secrets
**/.env
**/.env.*
!.env.example

# Repository and tooling
.git
.github
.husky
.changeset
.claude
.memory-bank
.devils-advocate
.fallow
.vscode
.idea

# Docs and internal artefacts
apps/docs/src
docs
**/*.md
!**/package.json
*.pen
public

# OS and editor files
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/*.log
**/*.bak
**/*.tmp
